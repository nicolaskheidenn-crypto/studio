rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) 
        && (request.resource.data.points <= resource.data.points + 500) // Prevent massive point injection
        && (request.resource.data.level >= resource.data.level);      // Level can only increase
    }

    // GoalCaps: Secure temporal storage
    match /users/{userId}/capsules/{capId} {
      allow read, write: if isOwner(userId);
    }

    // Activity Wall: Public wins, private comments
    match /activityWall/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn(); // For hearts and comments
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Global Resources: Read-only for general, Write for host
    match /resources/{resId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Simplified for prototype, ideally host only
    }

    // System Data: News, FAQs, Quizzes
    match /newsPosts/{id} { allow read: if isSignedIn(); }
    match /faqs/{id} { allow read: if isSignedIn(); }
    match /quizzes/{id} { allow read: if isSignedIn(); }
    match /rewards/{id} { allow read: if isSignedIn(); }
    match /shooppyProducts/{id} { allow read: if isSignedIn(); }
    match /tasks/{id} { allow read: if isSignedIn(); }
  }
}