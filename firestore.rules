rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: Is the user the Master Host?
    function isHost() {
      return isSignedIn() && request.auth.token.email == 'nicolaskheidenn@gmail.com';
    }

    // User Profile Rules: PUBLIC READ, but write only their own.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isHost();
    }

    // GoalCaps: Secure temporal storage - Owner Only
    match /users/{userId}/capsules/{capId} {
      allow read, write: if isOwner(userId);
    }

    // Activity Wall: Public wins, master moderated
    match /activityWall/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn(); // For hearts/insights
      allow delete: if isOwner(resource.data.userId) || isHost();
    }

    // Master Host Protected Collections: GLOBAL PUBLIC READ / HOST-ONLY WRITE
    match /tasks/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /quizzes/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /rewards/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /shooppyProducts/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /newsPosts/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /faqs/{id} { 
      allow read: if true; 
      allow write: if isHost(); 
    }
    match /resources/{id} {
      allow read: if true;
      allow create, update: if isSignedIn(); // Users can share in library
      allow delete: if isOwner(resource.data.userId) || isHost();
    }
  }
}