
{
  "entities": {
    "Task": {
      "title": "Daily Task",
      "description": "A task assigned to users for the day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "day": { "type": "number" }
      },
      "required": ["title", "description", "day"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "nickname": { "type": "string" },
        "bio": { "type": "string", "minLength": 15, "maxLength": 60 },
        "coverPhotoUrl": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "points": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" }
      }
    },
    "Resource": {
      "title": "Strategic Resource",
      "description": "A shared strategic tool (AI Prompt, T&Triks, or WeBin).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["AI_Prompt", "T&Triks", "WeBin"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "nickname": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "content", "nickname", "userId"]
    },
    "ActivityPost": {
      "title": "Activity Post",
      "description": "A shared 'Sovereign Win' on the activity wall.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "nickname": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "isPrivate": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "hearts": { "type": "number" }
      },
      "required": ["userId", "nickname", "description"]
    },
    "ShooppyProduct": {
      "title": "Shooppy Product",
      "description": "A digital asset in the marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string", "enum": ["Bundle", "Template", "eBook"] },
        "placement": { "type": "string", "enum": ["Hub", "Marketplace"] }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/tasks/{taskId}": { "schema": "Task", "description": "Global daily tasks." },
    "/users/{userId}": { "schema": "UserProfile", "description": "User profile data." },
    "/resources/{resourceId}": { "schema": "Resource", "description": "Global strategic resources." },
    "/activityWall/{postId}": { "schema": "ActivityPost", "description": "Shared activity wall wins." },
    "/shooppyProducts/{productId}": { "schema": "ShooppyProduct", "description": "Global digital marketplace assets." },
    "/newsPosts/{postId}": { "schema": "object", "description": "Global broadcast messages." },
    "/faqs/{faqId}": { "schema": "object", "description": "Global FAQs." }
  }
}
