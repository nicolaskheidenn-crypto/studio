
{
  "entities": {
    "Task": {
      "title": "Daily Task",
      "description": "A task assigned to users for the day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "day": { "type": "number" }
      },
      "required": ["title", "description", "day"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "nickname": { "type": "string" },
        "bio": { "type": "string", "minLength": 15, "maxLength": 60 },
        "coverPhotoUrl": { "type": "string" },
        "avatarUrl": { "type": "string" }
      }
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Request to connect between users.",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in a conversation.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AppNotification": {
      "title": "Notification",
      "description": "System or social alert.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "friend_request", "admin"] },
        "isRead": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/tasks/{taskId}": { "schema": "Task", "description": "Global daily tasks." },
    "/users/{userId}": { "schema": "UserProfile", "description": "User profile data." },
    "/friendRequests/{requestId}": { "schema": "FriendRequest", "description": "Social connections." },
    "/chats/{chatId}/messages/{msgId}": { "schema": "ChatMessage", "description": "Conversation data." },
    "/notifications/{notifId}": { "schema": "AppNotification", "description": "User alerts." }
  }
}
